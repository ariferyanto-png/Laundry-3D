<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laundry 3D Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #e0e5ec; /* Neumorphic base color */
            color: #4a5568;
            overflow-x: hidden;
        }

        /* 3D Card Effect */
        .card-3d {
            background-color: #e0e5ec;
            border-radius: 20px;
            box-shadow: 9px 9px 16px rgb(163,177,198,0.6), 
                       -9px -9px 16px rgba(255,255,255, 0.5);
            transition: all 0.3s ease;
        }

        /* 3D Button Effect */
        .btn-3d {
            background-color: #e0e5ec;
            border-radius: 12px;
            box-shadow: 5px 5px 10px rgb(163,177,198,0.6), 
                       -5px -5px 10px rgba(255,255,255, 0.5);
            transition: all 0.2s ease;
            cursor: pointer;
            font-weight: 600;
        }
        .btn-3d:active {
            box-shadow: inset 5px 5px 10px rgb(163,177,198,0.6), 
                       inset -5px -5px 10px rgba(255,255,255, 0.5);
            transform: scale(0.98);
        }

        /* 3D Input Effect */
        .input-3d {
            background-color: #e0e5ec;
            border-radius: 12px;
            box-shadow: inset 5px 5px 10px rgb(163,177,198,0.6), 
                       inset -5px -5px 10px rgba(255,255,255, 0.5);
            border: none;
            outline: none;
            padding: 12px 16px;
            width: 100%;
            transition: all 0.2s ease;
        }
        .input-3d:focus {
            box-shadow: inset 7px 7px 14px rgb(163,177,198,0.7), 
                       inset -7px -7px 14px rgba(255,255,255, 0.6);
        }

        /* 3D Icon Effect */
        .icon-3d {
            text-shadow: 2px 2px 4px rgba(163,177,198,0.8),
                        -2px -2px 4px rgba(255,255,255,0.8);
            background: linear-gradient(145deg, #4299e1, #3182ce);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 1.5rem;
        }

        /* Accent Colors */
        .text-accent { color: #3182ce; }
        .bg-accent { 
            background: linear-gradient(145deg, #4299e1, #3182ce);
            color: white;
            box-shadow: 5px 5px 10px rgba(49, 130, 206, 0.4), 
                       -5px -5px 10px rgba(255,255,255, 0.5);
        }
        .bg-accent:active {
            box-shadow: inset 3px 3px 6px rgba(42, 105, 172, 0.6),
                        inset -3px -3px 6px rgba(99, 179, 237, 0.4);
        }
        
        .bg-success { background: linear-gradient(145deg, #48bb78, #38a169); color: white;}
        .bg-danger { background: linear-gradient(145deg, #f56565, #e53e3e); color: white;}
        .bg-warning { background: linear-gradient(145deg, #ecc94b, #d69e2e); color: white;}

        /* Sidebar Navigation Active State */
        .nav-item.active {
            box-shadow: inset 4px 4px 8px rgb(163,177,198,0.6), 
                       inset -4px -4px 8px rgba(255,255,255, 0.5);
            color: #3182ce;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #e0e5ec; }
        ::-webkit-scrollbar-thumb { background: #a0aec0; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #718096; }

        /* Loader */
        .loader {
            border: 4px solid #e0e5ec;
            border-top: 4px solid #3182ce;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* Modal Overlay */
        .modal-overlay {
            background-color: rgba(224, 229, 236, 0.8);
            backdrop-filter: blur(5px);
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col md:flex-row overflow-hidden">

    <!-- Full Screen Loader (Auth check) -->
    <div id="global-loader" class="fixed inset-0 z-50 flex flex-col items-center justify-center modal-overlay">
        <div class="loader mb-4"></div>
        <p class="text-xl font-semibold text-gray-700 animate-pulse">Menghubungkan ke Cloud...</p>
    </div>

    <!-- Custom Notification/Alert Modal -->
    <div id="custom-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center modal-overlay">
        <div class="card-3d p-6 w-11/12 max-w-sm text-center">
            <h3 id="modal-title" class="text-xl font-bold mb-2 text-accent">Pemberitahuan</h3>
            <p id="modal-message" class="mb-6 text-gray-600">Pesan di sini</p>
            <button onclick="closeModal()" class="btn-3d bg-accent px-6 py-2 w-full">OK</button>
        </div>
    </div>

    <!-- Confirm Modal -->
    <div id="confirm-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center modal-overlay">
        <div class="card-3d p-6 w-11/12 max-w-sm text-center">
            <h3 id="confirm-title" class="text-xl font-bold mb-2 text-red-500">Konfirmasi</h3>
            <p id="confirm-message" class="mb-6 text-gray-600">Apakah anda yakin?</p>
            <div class="flex gap-4">
                <button onclick="closeConfirm(false)" class="btn-3d flex-1 px-4 py-2">Batal</button>
                <button id="confirm-btn-yes" class="btn-3d bg-danger flex-1 px-4 py-2">Ya</button>
            </div>
        </div>
    </div>

    <div id="login-screen" class="hidden fixed inset-0 z-40 flex items-center justify-center bg-[#e0e5ec]">
        <div class="card-3d p-8 w-11/12 max-w-md flex flex-col items-center">
            <div class="w-20 h-20 card-3d flex items-center justify-center mb-4 rounded-full">
                <i class="fas fa-tshirt icon-3d text-4xl"></i>
            </div>
            <h2 class="text-2xl font-bold mb-1 text-gray-700">Laundry 3D Pro</h2>
            <p id="login-subtitle" class="text-sm text-gray-500 mb-6 text-center">Masukkan sandi untuk mengakses</p>
            
            <form id="login-form" class="w-full" onsubmit="handleLogin(event)">
                <div class="mb-6">
                    <input type="password" id="app-password" class="input-3d text-center text-xl tracking-widest" placeholder="••••••" required>
                </div>
                <button type="submit" class="btn-3d bg-accent w-full py-3 text-lg" id="login-btn">Masuk</button>
            </form>
        </div>
    </div>

    <div id="app-screen" class="hidden flex-1 flex flex-col md:flex-row h-full w-full">
        <!-- Sidebar -->
        <nav class="md:w-64 w-full card-3d rounded-none md:rounded-r-[30px] z-20 flex flex-col p-4 flex-shrink-0 md:h-full overflow-y-auto">
            <div class="flex items-center gap-3 mb-8 p-2">
                <div class="w-12 h-12 card-3d flex items-center justify-center rounded-full">
                    <i class="fas fa-tshirt icon-3d text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-gray-800 leading-tight">Laundry<br><span class="text-accent">3D Pro</span></h1>
                </div>
            </div>

            <div class="flex flex-row md:flex-col gap-2 overflow-x-auto md:overflow-visible pb-2 md:pb-0 hide-scrollbar" id="nav-menu">
                <button onclick="navigate('dashboard')" class="nav-item active flex items-center gap-3 p-3 rounded-xl transition-all font-medium text-left flex-shrink-0">
                    <i class="fas fa-home w-5 text-center text-gray-500"></i> <span class="hidden md:inline">Beranda</span>
                </button>
                <button onclick="navigate('transactions')" class="nav-item flex items-center gap-3 p-3 rounded-xl transition-all font-medium text-left flex-shrink-0">
                    <i class="fas fa-cash-register w-5 text-center text-gray-500"></i> <span class="hidden md:inline">Transaksi</span>
                </button>
                <button onclick="navigate('reports')" class="nav-item flex items-center gap-3 p-3 rounded-xl transition-all font-medium text-left flex-shrink-0">
                    <i class="fas fa-chart-pie w-5 text-center text-gray-500"></i> <span class="hidden md:inline">Laporan</span>
                </button>
                <button onclick="navigate('finances')" class="nav-item flex items-center gap-3 p-3 rounded-xl transition-all font-medium text-left flex-shrink-0">
                    <i class="fas fa-wallet w-5 text-center text-gray-500"></i> <span class="hidden md:inline">Keuangan</span>
                </button>
                <div class="md:my-2 border-r md:border-r-0 md:border-b border-gray-300/50 mx-2 md:mx-0"></div>
                <button onclick="navigate('services')" class="nav-item flex items-center gap-3 p-3 rounded-xl transition-all font-medium text-left flex-shrink-0">
                    <i class="fas fa-list w-5 text-center text-gray-500"></i> <span class="hidden md:inline">Layanan</span>
                </button>
                <button onclick="navigate('customers')" class="nav-item flex items-center gap-3 p-3 rounded-xl transition-all font-medium text-left flex-shrink-0">
                    <i class="fas fa-users w-5 text-center text-gray-500"></i> <span class="hidden md:inline">Pelanggan</span>
                </button>
                <button onclick="navigate('employees')" class="nav-item flex items-center gap-3 p-3 rounded-xl transition-all font-medium text-left flex-shrink-0">
                    <i class="fas fa-user-tie w-5 text-center text-gray-500"></i> <span class="hidden md:inline">Karyawan</span>
                </button>
            </div>
            
            <div class="mt-auto pt-4 hidden md:block">
                <button onclick="logout()" class="btn-3d w-full p-3 flex items-center justify-center gap-2 text-red-500">
                    <i class="fas fa-sign-out-alt"></i> Keluar
                </button>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-8 w-full">
            
            <!-- VIEW: Dashboard -->
            <div id="view-dashboard" class="view-section">
                <h2 class="text-2xl font-bold mb-6 text-gray-800">Ringkasan Hari Ini</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    <div class="card-3d p-6 flex items-center gap-4">
                        <div class="w-14 h-14 rounded-full card-3d flex items-center justify-center text-blue-500"><i class="fas fa-wallet text-2xl"></i></div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Omset (Bulan ini)</p>
                            <p class="text-xl font-bold" id="dash-omset">Rp 0</p>
                        </div>
                    </div>
                    <div class="card-3d p-6 flex items-center gap-4">
                        <div class="w-14 h-14 rounded-full card-3d flex items-center justify-center text-yellow-500"><i class="fas fa-hourglass-half text-2xl"></i></div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Tx Masuk / Proses</p>
                            <p class="text-xl font-bold" id="dash-masuk">0</p>
                        </div>
                    </div>
                    <div class="card-3d p-6 flex items-center gap-4">
                        <div class="w-14 h-14 rounded-full card-3d flex items-center justify-center text-green-500"><i class="fas fa-check-circle text-2xl"></i></div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Tx Lunas</p>
                            <p class="text-xl font-bold" id="dash-lunas">0</p>
                        </div>
                    </div>
                    <div class="card-3d p-6 flex items-center gap-4">
                        <div class="w-14 h-14 rounded-full card-3d flex items-center justify-center text-red-500"><i class="fas fa-times-circle text-2xl"></i></div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Tx Batal</p>
                            <p class="text-xl font-bold" id="dash-batal">0</p>
                        </div>
                    </div>
                </div>

                <div class="card-3d p-6">
                    <h3 class="text-lg font-bold mb-4">Transaksi Terbaru</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="text-gray-500 text-sm border-b border-gray-300">
                                    <th class="pb-3 px-2">Tanggal</th>
                                    <th class="pb-3 px-2">Pelanggan</th>
                                    <th class="pb-3 px-2">Total</th>
                                    <th class="pb-3 px-2">Status</th>
                                </tr>
                            </thead>
                            <tbody id="dash-recent-tx">
                                <!-- Data injected here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- VIEW: Transactions -->
            <div id="view-transactions" class="view-section hidden">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">Data Transaksi</h2>
                    <button onclick="openModalTx()" class="btn-3d bg-accent px-4 py-2 text-sm flex items-center gap-2"><i class="fas fa-plus"></i> Transaksi Baru</button>
                </div>
                
                <div class="card-3d p-6 overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-gray-500 text-sm border-b border-gray-300">
                                <th class="pb-3 px-2">ID</th>
                                <th class="pb-3 px-2">Tanggal</th>
                                <th class="pb-3 px-2">Pelanggan</th>
                                <th class="pb-3 px-2">Layanan</th>
                                <th class="pb-3 px-2">Qty/Berat</th>
                                <th class="pb-3 px-2">Total</th>
                                <th class="pb-3 px-2">Status</th>
                                <th class="pb-3 px-2 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="table-transactions" class="text-sm"></tbody>
                    </table>
                </div>
            </div>

            <!-- VIEW: Reports -->
            <div id="view-reports" class="view-section hidden">
                <h2 class="text-2xl font-bold mb-6 text-gray-800">Laporan</h2>
                
                <div class="flex gap-4 mb-6 overflow-x-auto py-2 px-1">
                    <button onclick="filterReport('all')" class="btn-3d px-4 py-2 flex-shrink-0 text-sm bg-accent">Semua</button>
                    <button onclick="filterReport('masuk')" class="btn-3d px-4 py-2 flex-shrink-0 text-sm">Masuk</button>
                    <button onclick="filterReport('lunas')" class="btn-3d px-4 py-2 flex-shrink-0 text-sm">Lunas</button>
                    <button onclick="filterReport('batal')" class="btn-3d px-4 py-2 flex-shrink-0 text-sm">Batal</button>
                </div>

                <div class="card-3d p-6">
                    <div class="flex justify-between items-center mb-4 border-b border-gray-300 pb-2">
                        <h3 class="font-bold">Detail Laporan</h3>
                        <p class="font-bold text-accent" id="report-total-amount">Total: Rp 0</p>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="text-gray-500 text-sm border-b border-gray-300">
                                    <th class="pb-3 px-2">Tanggal</th>
                                    <th class="pb-3 px-2">Pelanggan</th>
                                    <th class="pb-3 px-2">Status</th>
                                    <th class="pb-3 px-2 text-right">Nominal</th>
                                </tr>
                            </thead>
                            <tbody id="table-reports" class="text-sm"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- VIEW: Finances -->
            <div id="view-finances" class="view-section hidden">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">Keuangan (Lainnya)</h2>
                    <button onclick="openModalFinance()" class="btn-3d bg-accent px-4 py-2 text-sm flex items-center gap-2"><i class="fas fa-plus"></i> Catat Keuangan</button>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div class="card-3d p-6 border-l-4 border-green-500">
                        <p class="text-sm text-gray-500">Total Pemasukan Tambahan</p>
                        <p class="text-xl font-bold text-green-600" id="fin-income">Rp 0</p>
                    </div>
                    <div class="card-3d p-6 border-l-4 border-red-500">
                        <p class="text-sm text-gray-500">Total Pengeluaran</p>
                        <p class="text-xl font-bold text-red-600" id="fin-expense">Rp 0</p>
                    </div>
                </div>

                <div class="card-3d p-6 overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-gray-500 text-sm border-b border-gray-300">
                                <th class="pb-3 px-2">Tanggal</th>
                                <th class="pb-3 px-2">Jenis</th>
                                <th class="pb-3 px-2">Keterangan</th>
                                <th class="pb-3 px-2 text-right">Nominal</th>
                                <th class="pb-3 px-2 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="table-finances" class="text-sm"></tbody>
                    </table>
                </div>
            </div>

            <!-- VIEW: Services -->
            <div id="view-services" class="view-section hidden">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">Data Layanan</h2>
                    <button onclick="openModalService()" class="btn-3d bg-accent px-4 py-2 text-sm flex items-center gap-2"><i class="fas fa-plus"></i> Tambah Layanan</button>
                </div>
                <div class="card-3d p-6 overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-gray-500 text-sm border-b border-gray-300">
                                <th class="pb-3 px-2">Kategori</th>
                                <th class="pb-3 px-2">Nama Layanan</th>
                                <th class="pb-3 px-2">Harga 